{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLAUDE.md Evaluation Result",
  "type": "object",
  "required": ["source_file", "quantitative_check", "semantic_check", "overall_score", "overall_grade", "top_issues", "recommendations"],
  "properties": {
    "source_file": {
      "type": "string",
      "description": "Path to the evaluated CLAUDE.md file"
    },
    "quantitative_check": {
      "type": "object",
      "required": ["line_count", "over_200_lines", "has_headers", "has_bullets", "has_commands", "has_essential_sections", "score"],
      "properties": {
        "line_count": { "type": "integer", "description": "Total line count" },
        "over_200_lines": { "type": "boolean", "description": "True if file exceeds 200 lines" },
        "has_headers": { "type": "boolean", "description": "True if markdown headers (#) are present" },
        "has_bullets": { "type": "boolean", "description": "True if bullet lists (-, *) are used" },
        "has_commands": { "type": "boolean", "description": "True if backtick-enclosed commands exist" },
        "imports_valid": { "type": "boolean", "description": "True if all @import paths resolve to existing files" },
        "rules_frontmatter_valid": { "type": "boolean", "description": "True if .claude/rules/ files have valid paths frontmatter" },
        "has_essential_sections": { "type": "boolean", "description": "True if at least one of build/test/code-style sections exists" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Quantitative score (0-100)" },
        "issues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of quantitative issues found"
        }
      }
    },
    "semantic_check": {
      "type": "object",
      "required": ["coherence_score", "grade", "summary", "claims"],
      "properties": {
        "coherence_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
        "summary": {
          "type": "object",
          "required": ["verified", "stale", "partial", "unverifiable", "vague", "generic"],
          "properties": {
            "verified": { "type": "integer" },
            "stale": { "type": "integer" },
            "partial": { "type": "integer" },
            "unverifiable": { "type": "integer" },
            "vague": { "type": "integer" },
            "generic": { "type": "integer" }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "raw_text", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^(cmd|path|fw|conv|name|env|vague|generic)-\\d+$" },
              "type": { "type": "string", "enum": ["command", "path_reference", "framework_reference", "convention", "naming_pattern", "env_reference", "vague", "generic"] },
              "raw_text": { "type": "string" },
              "source_section": { "type": "string" },
              "status": { "type": "string", "enum": ["verified", "stale", "partial", "unverifiable", "vague", "generic"] },
              "evidence": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "fix_suggestion": { "type": "string" }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_a", "claim_b", "description"],
            "properties": {
              "claim_a": { "type": "string" },
              "claim_b": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "overall_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "overall_grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
    "top_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "summary"],
        "properties": {
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "claim_id": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
